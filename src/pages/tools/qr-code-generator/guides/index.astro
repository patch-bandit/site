---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import '../../../../styles/qr-guides.css';
import { TOOLS_LABEL } from '../../../../data/site';

const allGuides = (await getCollection('qrGuides')).sort((a, b) => a.data.order - b.data.order);
const indexEntry = allGuides.find((g) => g.id === 'index')!;
const subGuides = allGuides.filter((g) => g.id !== 'index');
const { Content } = await render(indexEntry);
const { data } = indexEntry;
---
<Base title={data.title} description={data.description}>
  <PageHero tone="mint">
    <p class="crumbs">
      <a href="/">The story</a> / <a href="/tools/">{TOOLS_LABEL}</a> / <a href="/tools/qr-code-generator/">Bandit Codes</a> / Install guides
    </p>
    <p class="eyebrow">Plain-language guides · 11 platforms</p>
    <h1>{data.h1}</h1>
    <p class="lead">Step-by-step instructions to host Bandit Codes on your own website so every printed QR code stays yours, with zero developer jargon.</p>
    <p class="story">Pick your website platform below, or use the guided start inside Bandit Codes to pick the right path in two clicks.</p>
    <div class="btn-row">
      <a class="btn" href="/tools/qr-code-generator/">Open Bandit Codes studio</a>
      <a class="btn alt" href="/tools/qr-code-generator/guides/getting-started/">Get your files ready</a>
    </div>
    <Fragment slot="art">
      <svg class="guide-hero-art" viewBox="0 0 280 280" role="img" aria-label="An illustrated guide notebook beside a simple QR code badge on a dark alley background">
        <rect x="26" y="28" width="228" height="224" rx="22" fill="#1e1033" stroke="#86e3be" stroke-width="4" />
        <rect x="46" y="52" width="118" height="176" rx="12" fill="#fff2de" stroke="#140a22" stroke-width="4" />
        <rect x="62" y="74" width="84" height="10" rx="5" fill="#140a22" />
        <rect x="62" y="96" width="68" height="8" rx="4" fill="#4b2d6e" />
        <rect x="62" y="114" width="80" height="8" rx="4" fill="#4b2d6e" />
        <rect x="62" y="132" width="60" height="8" rx="4" fill="#4b2d6e" />
        <rect x="62" y="156" width="84" height="50" rx="8" fill="#86e3be" stroke="#140a22" stroke-width="3" />
        <rect x="74" y="170" width="60" height="8" rx="4" fill="#140a22" />
        <rect x="74" y="186" width="42" height="8" rx="4" fill="#140a22" />
        <rect x="176" y="74" width="62" height="62" rx="10" fill="#fff2de" stroke="#140a22" stroke-width="4" />
        <rect x="186" y="84" width="16" height="16" rx="3" fill="#140a22" />
        <rect x="212" y="84" width="16" height="16" rx="3" fill="#140a22" />
        <rect x="186" y="110" width="16" height="16" rx="3" fill="#140a22" />
        <rect x="212" y="110" width="16" height="16" rx="3" fill="#ff7b67" />
        <circle cx="207" cy="186" r="24" fill="#ffc857" stroke="#140a22" stroke-width="4" />
        <path d="M197 186 L204 193 L218 179" fill="none" stroke="#140a22" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </Fragment>
  </PageHero>

  <section class="band" aria-labelledby="platforms-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">All 12 guides</p>
          <h2 id="platforms-h">Pick your website platform</h2>
        </div>
        <p class="muted">Start with Get your files ready (or generate your files straight in Bandit Codes), then open the guide that matches where you edit your site.</p>
      </div>
      <ul class="grid g3 sub sub3">
        {subGuides.map((g) => (
          <li class="card">
            <p class="tag">{g.data.speed}</p>
            <h3><a href={`/tools/qr-code-generator/guides/${g.id}/`}>{g.data.platform}</a></h3>
            <p>{g.data.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band alt" aria-labelledby="full-overview-h">
    <div class="wrap">
      <h2 id="full-overview-h" class="sr">Full install guide overview</h2>
      <div class="guide-layout">
        <article class="card guide-prose">
          <Content />
          <p class="guide-note">
            Source: <code>{data.source}</code>. Every guide is open source under the MIT License and stays free to copy or adapt.
          </p>
        </article>
        <aside class="card guide-sidebar" aria-label="Quick navigation">
          <h2>Jump to a guide</h2>
          <ul class="guide-nav-list">
            <li><a href="/tools/qr-code-generator/">Back to Bandit Codes studio</a></li>
            <li><a href="/tools/qr-code-generator/guides/" aria-current="page">All install guides</a></li>
            {subGuides.map((g) => (
              <li><a href={`/tools/qr-code-generator/guides/${g.id}/`}>{g.data.platform}</a></li>
            ))}
          </ul>
        </aside>
      </div>
    </div>
  </section>
</Base>
