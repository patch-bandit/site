---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import '../../../styles/qr-generator.css';
import { GITHUB_URL, TOOLS_LABEL } from '../../../data/site';

const title = 'Free QR code generator (Bandit Codes) | Patch Bandit';
const description =
  'Free QR code generator for codes you own. Make static or own-domain QR codes, build redirect rules or a copy-paste snippet, and plan an escape from lock-in.';
const canonical = new URL('/tools/qr-code-generator/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bandit Codes',
  description,
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Runs locally in a modern browser; no server required',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'Generate static and own-domain QR codes in PNG and SVG',
    'Live in-browser scan verification and rule-of-thumb print width',
    'Export forwarding rules for Netlify, Cloudflare, Vercel, Apache, nginx, WordPress, and static HTML',
    'Build and update the self-hosted Bandit Codes HTML snippet and codes.json locally',
    'Decode photos of printed QR codes locally to check for subscription lock-in and plan replacements',
  ],
};
---
<Base title={title} description={description} schema={schema}>
  <PageHero tone="mint">
    <p class="crumbs"><a href="/">The story</a> / <a href="/tools/">{TOOLS_LABEL}</a> / Bandit Codes</p>
    <p class="eyebrow">Set free · MIT</p>
    <h1>Bandit Codes: free QR code generator for codes you own.</h1>
    <p class="lead">Use this free QR code generator to make codes you own, write forwarding rules or a copy-paste snippet for your own site, and plan a move off subscription QR lock-in. Every code is read back in your browser before you print.</p>
    <p class="story">Nothing leaves this tab. No server, no account, and no middleman sitting on your printed links.</p>
    <Fragment slot="art">
      <svg class="qr-hero-art" viewBox="0 0 280 280" role="img" aria-label="A scannable QR code styled as Snick the raccoon with notched ears above the frame, bandit mask finder eyes, tiny raccoon paw print squares, and Snick peeking out of the center holding a toasted golden sesame bagel" data-qr-cutout="45" data-qr-ec-total="10/32" data-qr-ec-peak="4/8" data-qr-quiet-modules="4.43">
        <defs>
          <clipPath id="qr-hero-card-clip">
            <rect x="27" y="37" width="226" height="226" rx="19" />
          </clipPath>
          <clipPath id="qr-hero-badge-clip">
            <circle cx="140" cy="150" r="17.5" />
          </clipPath>
          <linearGradient id="qr-hero-glow-mint" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#86e3be" stop-opacity="0" />
            <stop offset="0.5" stop-color="#86e3be" stop-opacity="0.22" />
            <stop offset="1" stop-color="#86e3be" stop-opacity="0" />
          </linearGradient>
          <g id="qr-hero-paw-mod">
            <circle cx="2.7" cy="3.38" r="1.88" />
            <circle cx="1.2" cy="1.45" r="0.79" />
            <circle cx="2.7" cy="0.92" r="0.79" />
            <circle cx="4.2" cy="1.45" r="0.79" />
          </g>
        </defs>
        <g class="qr-hero-ears" stroke="#140a22" stroke-width="4.5" stroke-linejoin="round" stroke-linecap="round">
          <path d="M46 37 L53 19 L62 16 L56 10 L62 5 Q65 3 68 6 L94 37 Z" fill="#c4bbd6" />
