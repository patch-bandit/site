---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import '../../../styles/qr-generator.css';
import { GITHUB_URL, TOOLS_LABEL } from '../../../data/site';

const title = 'Free QR code generator (Bandit Codes) | Patch Bandit';
const description =
  'Free QR code generator for links, Wi-Fi, contacts, email, texts, map spots, and events. Runs in your browser: no account, no tracking, MIT licensed.';
const canonical = new URL('/tools/qr-code-generator/', Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bandit Codes',
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<Base title={title} description={description} schema={schema}>
  <PageHero tone="mint">
    <p class="crumbs"><a href="/">The story</a> / <a href="/tools/">{TOOLS_LABEL}</a> / Bandit Codes</p>
    <p class="eyebrow">First free tool · MIT</p>
    <h1>Bandit Codes: free QR code generator on your device.</h1>
    <p class="lead">Use this free QR code generator to pick what your code should do, choose a look, and download PNG or SVG. Every code is read back in your browser to check that it scans. No account, no limits, no subscription.</p>
    <p class="story">Nothing you type leaves this tab. Zero servers, zero uploads, zero tracking.</p>
    <Fragment slot="art">
      <svg class="qr-hero-art" viewBox="0 0 280 280" role="img" aria-label="A styled QR code with a glowing mint scan line passing across it">
        <rect x="24" y="24" width="232" height="232" rx="22" fill="#fff2de" stroke="#140a22" stroke-width="6" />
        <g fill="#140a22">
          <rect x="44" y="44" width="54" height="54" rx="8" />
          <rect x="182" y="44" width="54" height="54" rx="8" />
          <rect x="44" y="182" width="54" height="54" rx="8" />
        </g>
        <g fill="#fff2de">
          <rect x="54" y="54" width="34" height="34" rx="4" />
          <rect x="192" y="54" width="34" height="34" rx="4" />
          <rect x="54" y="192" width="34" height="34" rx="4" />
        </g>
        <g fill="#ff7b67">
          <rect x="63" y="63" width="16" height="16" rx="3" />
          <rect x="201" y="63" width="16" height="16" rx="3" />
          <rect x="63" y="201" width="16" height="16" rx="3" />
        </g>
        <g fill="#4b2d6e">
          <rect x="114" y="50" width="16" height="16" rx="4" />
          <rect x="144" y="50" width="20" height="16" rx="4" />
          <rect x="128" y="80" width="18" height="18" rx="4" />
          <rect x="52" y="118" width="18" height="18" rx="4" />
          <rect x="82" y="118" width="34" height="18" rx="4" />
          <rect x="130" y="118" width="18" height="36" rx="4" />
          <rect x="162" y="114" width="24" height="18" rx="4" />
          <rect x="202" y="118" width="24" height="24" rx="5" />
          <rect x="66" y="150" width="22" height="18" rx="4" />
          <rect x="104" y="150" width="16" height="18" rx="4" />
          <rect x="162" y="148" width="24" height="24" rx="5" />
          <rect x="202" y="158" width="18" height="18" rx="4" />
          <rect x="118" y="186" width="22" height="18" rx="4" />
          <rect x="156" y="188" width="18" height="34" rx="4" />
          <rect x="190" y="192" width="36" height="18" rx="4" />
          <rect x="118" y="216" width="24" height="18" rx="4" />
          <rect x="196" y="220" width="26" height="14" rx="4" />
        </g>
        <rect class="qr-hero-scan" x="34" y="136" width="212" height="8" rx="4" fill="#86e3be" />
      </svg>
    </Fragment>
  </PageHero>

  <section class="band" aria-labelledby="tool-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">The tool</p>
          <h2 id="tool-h">Make your QR code</h2>
        </div>
        <p class="muted">Nine code types, six presets, custom colors, center logos, and a live scan check. Everything runs in plain TypeScript right here in this page.</p>
      </div>

      <div class="qr-app" id="generator" data-qr-app>
        <noscript>
          <div class="card qr-noscript">
            <h3>JavaScript is needed to draw codes in your browser</h3>
            <p>Bandit Codes builds and scan-checks QR codes locally in your browser tab so nothing is ever sent to a server. Enable JavaScript for this page, or run the MIT-licensed command line tool locally.</p>
          </div>
        </noscript>
      </div>
    </div>
  </section>

  <section class="band alt" aria-labelledby="how-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">How it works</p>
          <h2 id="how-h">No middleman. No expiring links.</h2>
        </div>
        <p class="muted">Bandit Codes puts your real content straight into the code. There is no redirect server that can break or start charging rent later.</p>
      </div>
      <ul class="grid g3 sub sub3">
        <li class="card">
          <p class="num">01</p>
          <h3>Runs locally</h3>
          <p>Your links, Wi-Fi keys, contact cards, and photos stay in this browser tab. No account, no upload, no analytics.</p>
        </li>
        <li class="card">
          <p class="num">02</p>
          <h3>Checked before you print</h3>
          <p>Every code is rasterized on an in-browser canvas and read back with an open source decoder at multiple module sizes.</p>
        </li>
        <li class="card">
          <p class="num">03</p>
          <h3>MIT open source</h3>
          <p>Includes a standalone web app and a Node CLI for batch generation. Read or fork the code on the <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">code account</a>.</p>
        </li>
      </ul>
      <p class="muted small" style="margin-top:1.5rem">QR Code is a registered trademark of DENSO WAVE INCORPORATED.</p>
    </div>
  </section>
</Base>

<style>
  .qr-hero-art { width: 100%; height: auto; display: block; }
  .qr-hero-scan { opacity: 0.9; }
  @media (prefers-reduced-motion: no-preference) {
    .qr-hero-scan { animation: qr-scan-sweep 3.4s ease-in-out infinite alternate; }
  }
  @keyframes qr-scan-sweep {
    from { transform: translateY(-76px); }
    to { transform: translateY(76px); }
  }
</style>

<script type="module" src="/tools/qr-code-generator.bundle.mjs"></script>
