---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import Raccoon from '../components/Raccoon.astro';
import PoolToy from '../components/PoolToy.astro';
import TypedLines, { type TypedLine } from '../components/TypedLines.astro';
import { nightLog } from '../data/pools';
import {
  GITHUB_URL,
  TAGLINE,
  HEADLINE,
  CREED,
  SITE_NAME,
  STATIC_PAGES,
  PATTERNS,
  HERO_TOOLS_BADGE,
  LAB_EXPERIMENTS,
  MANIFESTO_TOOLS_STATUS,
  inWords,
} from '../data/site';
import glintRaw from '../art/motif-glint.svg?raw';
// Each inline copy gets its own gradient id, so ids stay unique on the page.
const glint = (n: string) => glintRaw.replaceAll('gl-g', `gl-stand-${n}`);

const drops = (await getCollection('drops')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const allDrops = [
  ...LAB_EXPERIMENTS.map((d) => ({ id: d.id, h1: d.h1 })),
  ...drops.map((d) => ({ id: d.id, h1: d.data.h1 })),
];
const built = allDrops.length;
const page = STATIC_PAGES.find((p) => p.path === '/')!;

const manifesto: TypedLine[] = [
  { k: 'cmd', t: 'whoami' },
  { k: 'out', t: 'a raccoon. masked. awake when the city sleeps.' },
  { k: 'cmd', t: 'cat manifesto.txt' },
  { k: 'out', t: 'Some tools charge rent for a single button.' },
  { k: 'out', t: 'Some lock a simple job behind an account.' },
  { k: 'out', t: 'Some "free trials" quietly start billing.' },
  { k: 'gold', t: 'We never break anything. We never need to.' },
  { k: 'out', t: 'We find what is already free, take it apart, and put it back better.' },
  { k: 'out', t: 'Then we hand it to everyone, source included.' },
  { k: 'cmd', t: 'status' },
  { k: 'dim', t: `built: ${inWords(built)} lab experiments · ${MANIFESTO_TOOLS_STATUS} · seats open` },
];

const replacing = [
  { t: 'monthly fee for a basic tool', n: 'Our rule: a basic job stays free.' },
  { t: 'locked behind an account', n: 'Our rule: open the page and use it.' },
  { t: 'free trial that bills you', n: 'Our rule: free means free, forever.' },
  { t: 'pay to remove our logo', n: 'Our rule: your work carries your name.' },
];

const schema = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: 'https://patchbandit.com/' };
---
<Base title={page.title} description="Free online tools with no rent, accounts, or trackers: six browser tools live now, free CSS experiments to copy today, and an honest inventory." schema={schema}>
  <HeroScene>
    <p class="eyebrow">{TAGLINE}</p>
    <h1 id="hero-h">{HEADLINE}</h1>
    <p class="lead">Simple jobs on the web shouldn't come with a monthly bill, so we build free online tools anyone can run right in a browser. Quietly. At night. Source included.</p>
    <p class="chip">Built so far: {inWords(built)} lab experiments. {HERO_TOOLS_BADGE}</p>
    <div class="btn-row">
      <a class="btn" href="/lab/">Open the lab</a>
      <a class="btn ghost" href="/tools/">See the tools</a>
    </div>
    <p class="crew mono">The crew so far: one raccoon. Seats open.</p>
  </HeroScene>

  <div class="route-host">
    <div class="route-rail" data-route aria-hidden="true"><i></i></div>

    <section class="band night flash" data-node aria-labelledby="mf-h">
      <div class="wrap cols2 wide-right">
        <div class="rv">
          <p class="eyebrow">The manifesto</p>
          <h2 id="mf-h">Read it the way we wrote it: in a terminal, after midnight.</h2>
          <p>No speech, no shouting. Eleven lines that say what we do, what we refuse to do, and exactly how far we have got.</p>
        </div>
        <div class="term big rv" style="--i:1" data-type>
          <div class="term-bar"><i></i><i></i><i></i><span>~/manifesto</span></div>
          <div class="term-body">
            <TypedLines lines={manifesto} srLabel="The manifesto" />
          </div>
          <div class="term-foot">
            <a href="/den/#how-typing-works">How the typing works &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <section class="band" data-node aria-labelledby="a1-h">
      <div class="wrap">
        <div class="split-head rv">
          <div>
            <p class="eyebrow">Act one: the fee trap</p>
            <h2 id="a1-h">Somebody is charging rent on a button.</h2>
          </div>
          <p class="lead">Simple jobs on a computer used to be free. Many still are, if you know where to look. Too often, they come wrapped in fees, accounts, and someone watching.</p>
        </div>
        <ul class="grid g3 sub sub3">
          {PATTERNS.map((p, i) => (
            <li class="card glint rv" style={i ? `--i:${i}` : undefined}>
              <p class="tag">{p.tag}</p>
              <h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))}
        </ul>

        <div class="cols2 mt data-box">
          <div class="card rv">
            <p class="tag">Your data stays yours</p>
            <h3>Built to run on your device</h3>
            <p>These free web tools run right in your tab. Your files and text stay on your machine, with no accounts, no trackers, no ads, and no cookies.</p>
          </div>
          <div class="card rv" style="--i:1">
            <p class="tag">Check it yourself</p>
            <h3>Verify it in two minutes</h3>
            <p>Pop open your Network tab while you poke around here. Every file loads from this domain with no third-party requests, and the source ships alongside every demo and tool.</p>
          </div>
        </div>

        <h3 class="h-rep mt rv">What we're replacing</h3>
        <ul class="strike-list">
          {replacing.map((r, i) => (
            <li class="rv" style={`--i:${i}`}>
              <s>
                {r.t}
                <svg class="claw" viewBox="0 0 260 32" preserveAspectRatio="none" aria-hidden="true">
                  <path pathLength="1" d="M3 20 Q74 11 146 15 T257 9" />
                  <path pathLength="1" d="M9 26 Q94 17 170 20 T252 14" />
                  <path pathLength="1" d="M1 12 Q86 6 156 10 T248 5" />
                </svg>
              </s>
              <span class="gone">{r.n}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band alt" data-node aria-labelledby="a2-h">
      <div class="wrap">
        <div class="split-head rv">
          <div>
            <p class="eyebrow">Act two: the bench work</p>
            <h2 id="a2-h">{CREED}</h2>
          </div>
          <p class="lead">A raccoon doesn't smash the lock. It studies the latch until the latch makes sense, and then it opens on its own.</p>
        </div>
        <ul class="grid g3 sub sub3">
          <li class="card rv"><p class="num">01</p><h3>Find what's already free</h3><p>Browsers, open formats, and open source code already handle most of the job. Check the shelf first, build second.</p></li>
          <li class="card rv" style="--i:1"><p class="num">02</p><h3>Take it apart</h3><p>Pop the hood and trace every piece. When you actually know how it ticks, the fix stays small, clean, and easy to verify.</p></li>
          <li class="card rv" style="--i:2"><p class="num">03</p><h3>Put it back better</h3><p>Lighter, plainer, and free, with the source sitting right beside it. You can pull our work apart too, anytime you want.</p></li>
        </ul>

        <div class="cols2 wide-left mt apart-row">
          <div class="apart-stage rv">
            <Raccoon labels apart={0} size="min(78vw, 380px)" />
          </div>
          <div class="rv" style="--i:1">
            <p class="eyebrow">Proof on the page</p>
            <h3 class="h-xl">This raccoon is drawn in CSS. Take it apart.</h3>
            <p>No image file. Every piece is a plain box cut with <code>clip-path</code>, outlined with four hard shadows, and scaled by one variable. Press the button and it comes apart, labeled.</p>
            <div class="btn-row">
              <button type="button" class="btn alt" data-apart aria-pressed="false">Take this raccoon apart</button>
              <a class="btn ghost" href="/lab/css-art-raccoon/">See how it's drawn</a>
            </div>
            <p class="muted small" style="margin-top:1rem">It wrote "this will never break" at 3 AM. It broke at 3:05. That is how we learned to take things apart.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band night flash" data-node aria-labelledby="a3-h">
      <div class="wrap">
        <div class="split-head rv">
          <div>
            <p class="eyebrow">Act three: set it free</p>
            <h2 id="a3-h">Locked tools, set free.</h2>
          </div>
          <p class="lead">Each of our open source tools does one small job, runs in your browser, asks for no account, and comes with its code. Here is what we stand for while we get there.</p>
        </div>
        <ul class="grid g3 sub sub3">
          <li class="card glint rv"><span class="spark" aria-hidden="true" set:html={glint('1')} /><p class="tag">Stand for</p><h3>Take it apart</h3><p>Never trust a black box. Every tool we ship is built so you can open the cover and inspect every line yourself.</p></li>
          <li class="card glint rv" style="--i:1"><span class="spark" aria-hidden="true" set:html={glint('2')} /><p class="tag">Stand for</p><h3>Give it away</h3><p>Small tools anyone can open, read, and remix. No sign-ups, no trackers, no ads, and every lab snippet ships under MIT.</p></li>
          <li class="card glint rv" style="--i:2"><span class="spark" aria-hidden="true" set:html={glint('3')} /><p class="tag">Stand for</p><h3>Build it together</h3><p>One raccoon on the bench today, plenty of room beside it. Grab any idea from the stash, lend a pair of paws, and share the credit.</p></li>
        </ul>

        <div class="cols2 mt spot">
          <div class="card gold rv">
            <p class="status free" style="color:#0b4a35">Set free</p>
            <h3 class="h-spot"><a href="/tools/contrast-checker/">Spotlight: color contrast checker</a></h3>
            <p>Two colors in, plain pass or fail out. It tells you straight: "Too faint for small text. Fine for big headings." Offers a nearest passing color and keeps share links in the URL hash.</p>
            <p><a class="btn alt" href="/tools/contrast-checker/">Open Spotlight</a></p>
          </div>
          <div class="switch-card card rv" style="--i:1">
            <p class="tag">Flip the switch</p>
            <h3>What changes when a tool is set free?</h3>
            <button type="button" class="switch" data-switch aria-pressed="false">
              <span class="track" aria-hidden="true"><span class="knob"></span></span>
              <span class="state" data-switch-text>Monthly fee: ON</span>
            </button>
            <p class="muted" data-switch-note>Go on, flip it. Nobody gets billed either way, because this switch just shows the point.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" data-node>
      <div class="wrap">
        <PoolToy
          id="night-log"
          kind="log"
          title="The Night Log"
          intro="Pull one entry from the raccoon's night log. Every line is made up: a joke bug confession, a joke patch note, or a snack record. No real project, no real release."
          button="Read an entry"
          again="Read another"
          idle="The log is quiet. Something in there is probably embarrassing."
          pool={nightLog}
          noun="entries"
        />
      </div>
    </section>

    <section class="band alt" data-node aria-labelledby="inv-h">
      <div class="wrap">
        <div class="split-head rv">
          <div>
            <p class="eyebrow">No fluff, just the tally</p>
            <h2 id="inv-h">Here's exactly what exists.</h2>
          </div>
          <p class="lead">No inflated numbers, no "coming soon" that never comes. These cards change only when something actually ships.</p>
        </div>
        <ul class="grid g3 sub sub4">
          <li class="card mint rv">
            <p class="tag">Built</p>
            <h3>{inWords(built)[0].toUpperCase() + inWords(built).slice(1)} lab experiments</h3>
            <p>Compact CSS tricks with live demos and MIT code ready to paste, including:</p>
            <ul class="inv-links">
              {allDrops.slice(0, 3).map((d) => <li><a href={`/lab/${d.id}/`}>{d.h1}</a></li>)}
              <li><a href="/lab/">Browse all {inWords(built)} in the lab &rarr;</a></li>
            </ul>
          </li>
          <li class="card rv" style="--i:1">
            <p class="tag">Tools</p>
            <h3>Six tools set free</h3>
            <p><a href="/tools/qr-code-generator/">Bandit Codes</a>, <a href="/tools/px-to-rem/">px to rem converter</a>, <a href="/tools/uuid-generator/">UUID generator</a>, <a href="/tools/contrast-checker/">Spotlight</a>, <a href="/tools/html-boilerplate-generator/">HTML boilerplate generator</a>, and <a href="/tools/markdown-to-html/">Markdown to HTML converter</a> are out in the wild. Three more ideas are waiting in the stash.</p>
            <p><a href="/tools/">See all six tools</a> · <a href="/den/">See the stash</a></p>
          </li>
          <li class="card rv" style="--i:2">
            <p class="tag">Everyone else</p>
            <h3>No users, partners, or tips yet</h3>
            <p>No sponsors, no backers, and no big user count yet. We would rather tell it straight than pad the numbers, and the <a href="/snacks/">snack jar</a> sits ready if that ever changes.</p>
            <p class="mono small">crew: 1 raccoon · seats: open</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="band night flash crate-band" data-node="end" aria-labelledby="end-h">
      <div class="wrap cols2 wide-right">
        <div class="crate-art rv" aria-hidden="true">
          <svg viewBox="0 0 420 300" class="crates">
            <defs>
              <radialGradient id="cr-glow" cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#86e3be" stop-opacity="0.55" /><stop offset="1" stop-color="#86e3be" stop-opacity="0" /></radialGradient>
            </defs>
            <ellipse cx="210" cy="150" rx="210" ry="150" fill="url(#cr-glow)" />
            <g stroke="#140a22" stroke-width="6" stroke-linejoin="round">
              <rect x="20" y="190" width="110" height="90" rx="8" fill="#4b2d6e" />
              <path d="M20 220 H130 M20 250 H130" />
              <rect x="290" y="190" width="110" height="90" rx="8" fill="#4b2d6e" />
              <path d="M290 220 H400 M290 250 H400" />
              <rect x="150" y="200" width="120" height="80" rx="8" fill="#5b5075" />
              <path d="M150 228 H270 M150 254 H270" />
              <rect x="166" y="122" width="88" height="62" rx="8" fill="#0b0414" />
              <rect x="150" y="182" width="120" height="16" rx="6" fill="#c4bbd6" />
            </g>
            <path d="M180 140 l12 9 -12 9 M200 160 h22" stroke="#c2ffe6" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            <circle class="ember e1" cx="60" cy="170" r="5" fill="#ffc857" />
            <circle class="ember e2" cx="360" cy="166" r="4" fill="#86e3be" />
            <circle class="ember e3" cx="330" cy="120" r="3" fill="#ffc857" />
          </svg>
          <img class="crate-coon" src="/art/raccoon-celebrate.svg" alt="" width="1000" height="1000" />
        </div>
        <div class="rv" style="--i:1">
          <p class="eyebrow">Door's open</p>
          <h2 id="end-h">Pull up a crate.</h2>
          <p class="lead">The screen is on and there is room by the glow. Copy a snippet from the lab, check what is on the bench, or pick an idea from the stash.</p>
          <div class="btn-row">
            <a class="btn" href="/lab/">Open the lab</a>
            <a class="btn alt" href="/den/">See the stash</a>
            <a class="btn ghost" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">Visit the code account</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .crew { margin: 1.1rem 0 0; color: #d2cae2; font-size: 0.9rem; }
  .h-rep { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 1.1rem; }
  .h-spot { font-size: clamp(1.5rem, 2.6vw, 2rem); margin-top: 0.8rem; }
  .data-box { align-items: stretch; }
  .data-box > .card { display: flex; flex-direction: column; }
  .apart-stage { display: grid; place-items: center; padding-block: 3rem 4rem; }
  :global(.motion) .apart-stage :global(.pc) { transition: transform 0.7s cubic-bezier(.2,.9,.2,1.1); }
  :global(.motion) .apart-stage :global(.lbl) { transition: opacity 0.5s 0.25s, transform 0.7s cubic-bezier(.2,.9,.2,1.1); }
  :global(.motion) .apart-stage :global(.brow),
  :global(.motion) .apart-stage :global(.eye),
  :global(.motion) .apart-stage :global(.eye::before),
  :global(.motion) .apart-stage :global(.eye b),
  :global(.motion) .apart-stage :global(.mouth),
  :global(.motion) .apart-stage :global(.mouth-wob),
  :global(.motion) .apart-stage :global(.sweat) {
    transition: transform 0.55s ease, opacity 0.45s ease, top 0.55s ease, left 0.55s ease, width 0.55s ease, height 0.55s ease;
  }
  .inv-links { margin: 0; padding-left: 1.1rem; }
  .inv-links li + li { margin-top: 0.3rem; }
  .inv-links a { color: var(--k-ink); font-weight: 600; }
  .spot { align-items: stretch; }
  .spot > .card { display: flex; flex-direction: column; justify-content: center; }
  .switch { display: inline-flex; align-items: center; gap: 0.9rem; background: none; border: 0; padding: 0.4rem 0; margin: 0.2rem 0 1rem; color: inherit; font: 700 1.15rem/1.3 var(--mono); cursor: pointer; text-align: left; min-height: 2.75rem; }
  .track { width: 4.2rem; height: 2.3rem; border-radius: 999px; background: var(--k-coral); border: 3px solid var(--k-ink); position: relative; flex: none; box-shadow: 0 0 0 2px rgb(255 123 103 / 0.35); }
  .knob { position: absolute; top: 0.2rem; left: 0.25rem; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--k-cream); border: 3px solid var(--k-ink); }
  .switch[aria-pressed="true"] .track { background: var(--k-mint); box-shadow: 0 0 18px rgb(134 227 190 / 0.6); }
  .switch[aria-pressed="true"] .knob { left: auto; right: 0.25rem; }
  .crate-art { position: relative; width: min(100%, 30rem); justify-self: center; }
  .crates { display: block; width: 100%; height: auto; }
  .crate-coon { position: absolute; width: 38%; left: 31%; top: -6%; height: auto; filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.5)); }
  @media (prefers-reduced-motion: no-preference) {
    .knob { transition: left 0.25s, right 0.25s; }
    .ember { animation: ember 3.2s ease-in-out infinite; }
    .e2 { animation-delay: 1.1s; }
    .e3 { animation-delay: 2s; }
    @keyframes ember { 0% { transform: translateY(0); opacity: 0; } 30% { opacity: 1; } 100% { transform: translateY(-60px); opacity: 0; } }
  }
</style>

<script>
  // take the CSS raccoon apart and put it back
  const apartBtn = document.querySelector<HTMLButtonElement>('[data-apart]');
  const rc = document.querySelector<HTMLElement>('.apart-stage [data-rc]');
  apartBtn?.addEventListener('click', () => {
    const on = apartBtn.getAttribute('aria-pressed') !== 'true';
    apartBtn.setAttribute('aria-pressed', String(on));
    rc?.style.setProperty('--apart', on ? '1' : '0');
    apartBtn.textContent = on ? 'Put it back together' : 'Take this raccoon apart';
  });

  // the fee switch
  const sw = document.querySelector<HTMLButtonElement>('[data-switch]');
  const swText = document.querySelector<HTMLElement>('[data-switch-text]');
  const swNote = document.querySelector<HTMLElement>('[data-switch-note]');
  sw?.addEventListener('click', () => {
    const free = sw.getAttribute('aria-pressed') !== 'true';
    sw.setAttribute('aria-pressed', String(free));
    if (swText) swText.textContent = free ? 'Monthly fee: OFF' : 'Monthly fee: ON';
    if (swNote) swNote.textContent = free
      ? "Free tool: on the bench or in the stash, no monthly fee."
      : 'Go on, flip it. Nobody gets billed either way, because this switch just shows the point.';
  });
</script>
