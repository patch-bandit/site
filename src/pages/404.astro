---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { LAB_EXPERIMENTS, TOOLS_LABEL, inWords } from '../data/site';

const labCount = (await getCollection('drops')).length + LAB_EXPERIMENTS.length;
const doors = [
  {
    tag: 'Start here',
    href: '/',
    title: 'The story',
    body: 'Why we build free online tools with no accounts, no trackers, and no monthly bill. You also get the honest tally of what actually exists.',
  },
  {
    tag: TOOLS_LABEL,
    href: '/tools/',
    title: 'Free online tools',
    body: 'Fire up Bandit Codes, our browser QR code generator, and see the plain checks every tool has to pass before it ships.',
  },
  {
    tag: 'Live demos',
    href: '/lab/',
    title: 'The lab',
    body: `Dig through ${inWords(labCount)} live CSS experiments and the CSS art raccoon. Every snippet is MIT licensed and ready to paste today.`,
  },
  {
    tag: 'Ideas & rules',
    href: '/den/',
    title: 'The stash',
    body: 'Check the ten house rules, browse tool ideas waiting for a bench slot, or pitch what should hit the bench next.',
  },
];
---
<Base
  title="Page not found | Patch Bandit"
  description="This page isn't in the stash. Head back to the story, the tools, the stash, or the lab."
  noindex
>
  <PageHero art="/art/raccoon-smirk.svg" alt="The raccoon, mask on, with a knowing smirk" tone="coral">
    <p class="eyebrow mono">&gt; 404: empty corner</p>
    <h1>This page isn't in the stash</h1>
    <p class="lead">Snick checked every corner of the den and came back with half a bagel. Whatever you wanted is gone, or it was never here.</p>
    <div class="btn-row">
      <a class="btn" href="/">Back home</a>
      <a class="btn alt" href="/tools/">See the tools</a>
      <a class="btn alt" href="/lab/">Open the lab</a>
    </div>
  </PageHero>

  <section class="band tight lost-doors" aria-labelledby="where-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">Pick a door</p>
          <h2 id="where-h">Four real doors in this stash</h2>
        </div>
        <p class="muted">Every real page on this site sits behind one of these four doors. Pick your spot, or grab a free CSS snippet on the way out.</p>
      </div>
      <ul class="grid g2 sub sub3">
        {doors.map((d) => (
          <li class="card glint">
            <p class="tag">{d.tag}</p>
            <h3><a href={d.href}>{d.title}</a></h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
