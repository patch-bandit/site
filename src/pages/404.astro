---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { LAB_EXPERIMENTS, TOOLS_LABEL, inWords } from '../data/site';

const labCount = (await getCollection('drops')).length + LAB_EXPERIMENTS.length;
const doors = [
  {
    tag: 'Start here',
    href: '/',
    title: 'The story',
    body: 'Why we build free online tools with no accounts, no trackers, and no monthly fee, plus an honest inventory of what exists.',
  },
  {
    tag: TOOLS_LABEL,
    href: '/tools/',
    title: 'Free online tools',
    body: 'Open Bandit Codes (our free QR code generator) and see the plain checks every tool passes before it ships.',
  },
  {
    tag: 'Live demos',
    href: '/lab/',
    title: 'The lab',
    body: `Browse all ${inWords(labCount)} working CSS experiments and the CSS art raccoon, each with MIT-licensed code you can copy today.`,
  },
  {
    tag: 'Ideas & rules',
    href: '/den/',
    title: 'The stash',
    body: 'Read the ten house rules, see the tool ideas waiting for a bench slot, or pitch a tool you want built next.',
  },
];
---
<Base
  title="Page not found | Patch Bandit"
  description="This page isn't in the stash. Head back to the story, the tools, the stash, or the lab."
  noindex
>
  <PageHero art="/art/raccoon-smirk.svg" alt="The raccoon, mask on, with a knowing smirk" tone="coral">
    <p class="eyebrow mono">&gt; 404: path not found</p>
    <h1>This page isn't in the stash</h1>
    <p class="lead">Snick searched every corner and found only a bagel. The page you wanted is gone, or it never existed.</p>
    <div class="btn-row">
      <a class="btn" href="/">Back home</a>
      <a class="btn alt" href="/tools/">See the tools</a>
      <a class="btn alt" href="/lab/">Open the lab</a>
    </div>
  </PageHero>

  <section class="band tight lost-doors" aria-labelledby="where-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">Back on the trail</p>
          <h2 id="where-h">Four real doors in this stash</h2>
        </div>
        <p class="muted">Every page on this site lives behind one of these four doors. Pick where you meant to go, or grab a free CSS snippet while you are here.</p>
      </div>
      <ul class="grid g2 sub sub3">
        {doors.map((d) => (
          <li class="card glint">
            <p class="tag">{d.tag}</p>
            <h3><a href={d.href}>{d.title}</a></h3>
            <p>{d.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
