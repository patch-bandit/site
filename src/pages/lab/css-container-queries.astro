---
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PageHero from '../../components/PageHero.astro';
import WhyFree from '../../components/WhyFree.astro';
import DevNote from '../../components/lab/DevNote.astro';

const sizeCss = `/* 1. Turn the wrapper into a named inline-size container */
.card-slot {
  container-type: inline-size;
  container-name: card;
}

/* 2. Adapt the card to its own box width, plus fluid cqi type */
.item-card {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
}
.item-card h3 {
  font-size: clamp(1.05rem, 4.5cqi, 1.55rem);
}

@container card (min-width: 340px) {
  .item-card { padding: 1.25rem; }
  .item-card .meta { display: flex; gap: 0.6rem; }
}

@container card (min-width: 540px) {
  .item-card {
    grid-template-columns: 11rem 1fr;
    align-items: center;
    gap: 1.35rem;
  }
}`;

const styleCss = `/* 3. Flip inner card looks with CSS style queries (Baseline 2026) */
.card-slot.is-featured {
  --variant: featured;
}
.card-slot.is-compact {
  --variant: compact;
}

@container card style(--variant: featured) {
  .item-card {
    border-color: #ffc857;
    background: #2b1840;
  }
  .item-card .badge {
    background: #ffc857;
    color: #170c26;
  }
}

@container card style(--variant: compact) {
  .item-card {
    padding: 0.85rem 1rem;
    border-style: dashed;
  }
  .item-card .blurb { display: none; }
}`;

const htmlSnippet = `<div class="card-slot is-featured">
  <article class="item-card">
    <div class="thumb" aria-hidden="true">QR</div>
    <div class="body">
      <span class="badge">Browser tool</span>
      <h3>Bandit Codes</h3>
      <p class="blurb">Build SVG and PNG codes locally with no login.</p>
      <p class="meta">Zero uploads · MIT code</p>
    </div>
  </article>
</div>`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'CSS container query and style queries',
  datePublished: '2026-11-22',
  url: 'https://patchbandit.com/lab/css-container-queries/',
};
---
<Base
  title="CSS container query and style queries: live card demo"
  description="Build a responsive CSS container query card with inline-size, cqi fluid type, and style queries — zero media queries or JavaScript. Live demo and code."
  schema={schema}
  ogType="article"
>
  <PageHero art="/art/raccoon-master.svg" alt="Snick the raccoon testing a resizing card" tone="mint">
    <p class="crumbs"><a href="/">The story</a> / <a href="/lab/">The lab</a></p>
    <p class="eyebrow">Waffle fry · 2026-11-22</p>
    <h1>CSS container query and style queries</h1>
    <p class="lead">A CSS container query lets a component respond to the width of its own box instead of the whole browser screen, so one card works cleanly in a narrow sidebar or a wide grid. Pair size rules with CSS style queries and a single custom property can switch layouts and themes with zero JavaScript.</p>
    <p class="story">Stop rewriting viewport breakpoints every time a card moves into a sidebar.</p>
  </PageHero>

  <div class="route-host">
    <div class="route-rail" data-route aria-hidden="true"><i></i></div>

    <section class="band" data-node aria-labelledby="cq-play-h">
      <div class="wrap">
        <div class="cq-lab card">
          <div class="cq-head">
            <div>
              <h2 id="cq-play-h">Resize the container and switch its style variant</h2>
              <p class="muted small">Pick a preset width below (or drag the bottom-right corner on desktop) and toggle <code>--variant</code> to test container size queries and container style queries together — zero JavaScript.</p>
            </div>
            <div class="cq-controls">
              <fieldset class="cq-group">
                <legend class="mono small">Container width</legend>
                <div class="cq-pills">
                  <input type="radio" name="cq-w" id="cq-w-narrow" />
                  <label for="cq-w-narrow">Sidebar 260px</label>
                  <input type="radio" name="cq-w" id="cq-w-mid" />
                  <label for="cq-w-mid">Card 420px</label>
                  <input type="radio" name="cq-w" id="cq-w-wide" checked />
                  <label for="cq-w-wide">Wide split</label>
                </div>
              </fieldset>

              <fieldset class="cq-group">
                <legend class="mono small">Style query (--variant)</legend>
                <div class="cq-pills">
                  <input type="radio" name="cq-v" id="cq-v-default" checked />
                  <label for="cq-v-default">default</label>
                  <input type="radio" name="cq-v" id="cq-v-featured" />
                  <label for="cq-v-featured">featured</label>
                  <input type="radio" name="cq-v" id="cq-v-compact" />
                  <label for="cq-v-compact">compact</label>
                </div>
              </fieldset>
            </div>
          </div>

          <div class="cq-stage" role="group" aria-label="Live CSS container query and style query sandbox">
            <div class="cq-slot">
              <article class="cq-card">
                <div class="cq-emblem" aria-hidden="true">
                  <svg viewBox="0 0 80 80" width="64" height="64">
                    <rect x="6" y="6" width="24" height="24" rx="4" fill="currentColor" />
                    <rect x="12" y="12" width="12" height="12" rx="2" fill="#170c26" />
                    <rect x="50" y="6" width="24" height="24" rx="4" fill="currentColor" />
                    <rect x="56" y="12" width="12" height="12" rx="2" fill="#170c26" />
                    <rect x="6" y="50" width="24" height="24" rx="4" fill="currentColor" />
                    <rect x="12" y="56" width="12" height="12" rx="2" fill="#170c26" />
                    <rect x="38" y="38" width="10" height="10" rx="2" fill="currentColor" />
                    <rect x="54" y="50" width="20" height="10" rx="2" fill="currentColor" />
                    <rect x="38" y="56" width="10" height="18" rx="2" fill="currentColor" />
                    <rect x="54" y="64" width="20" height="10" rx="2" fill="currentColor" />
                  </svg>
                  <span class="mono cq-emblem-tag">local · svg/png</span>
                </div>

                <div class="cq-copy">
                  <div class="cq-badges">
                    <span class="cq-pill mono">Bandit Codes</span>
                    <span class="cq-state mono">
                      <span class="st-sm">Layout: badge (&lt; 340px)</span>
                      <span class="st-md">Layout: stacked (340–539px)</span>
                      <span class="st-lg">Layout: split (&gt;= 540px)</span>
                    </span>
                  </div>
                  <p class="cq-title">Free browser QR studio, zero login</p>
                  <p class="cq-blurb">Generates sharp SVG and PNG codes right inside your browser tab. No account wall, no redirect links, and no monthly fee for plain squares.</p>
                  <p class="cq-meta mono">
                    <span>Type scales with <code>cqi</code></span>
                    <span>Matches <code>@container</code></span>
                  </p>
                </div>
              </article>
            </div>
            <p class="cq-drag-hint mono small">Desktop tip: drag the coral corner handle on the box above to scrub smoothly across every breakpoint.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band alt" data-node aria-labelledby="how-cq-h">
      <div class="wrap cols2 wide-left top">
        <div>
          <h2 id="how-cq-h">Why a CSS container beats viewport media queries</h2>
          <p>Traditional <code>@media</code> rules only know how wide the whole browser window is. Drop the same product card into a wide hero and a tight sidebar on the same desktop page, and a media query cannot tell them apart.</p>
          <p>With <strong>CSS container queries</strong>, you mark a parent wrapper with <code>container-type: inline-size</code>. Every child inside can then query that wrapper's width, scale text smoothly with <code>cqw</code> and <code>cqi</code> container query units, and read custom properties with <code>@container style(--variant: featured)</code>.</p>

          <DevNote>
            <p>Always prefer <code>container-type: inline-size</code> over <code>size</code> for normal cards: <code>size</code> also enforces block containment, which collapses a box's height to zero unless you set an explicit height. Remember that a container cannot query itself — place <code>container-type</code> on the outer slot and put your <code>@container</code> rules on the component inside it.</p>
          </DevNote>
        </div>

        <div class="card cq-guide">
          <h3>Three rules running in the demo</h3>
          <ul class="cq-ref-list">
            <li>
              <span class="mono cq-ref-tag">&lt; 340px · compact badge</span>
              <p>Hides the decorative square graphic and tightens padding so the card fits inside tight rails and phone columns.</p>
            </li>
            <li>
              <span class="mono cq-ref-tag">340px–539px · stacked card</span>
              <p>Reveals the emblem strip above the text and opens up spacing while fluid <code>cqi</code> type grows smoothly.</p>
            </li>
            <li>
              <span class="mono cq-ref-tag">&gt;= 540px · horizontal split</span>
              <p>Switches to a two-column grid with the graphic anchored on the left beside full copy and metadata.</p>
            </li>
            <li>
              <span class="mono cq-ref-tag">style(--variant: ...)</span>
              <p>Reads one custom property on the container to swap into the gold <code>featured</code> look or dashed <code>compact</code> mode.</p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band" data-node aria-labelledby="code-cq-h">
      <div class="wrap">
        <h2 id="code-cq-h">Copy the CSS container query and style query code</h2>
        <div class="cols2 top">
          <div>
            <CodeBlock label="Container size queries and cqi units (CSS)" code={sizeCss} />
            <CodeBlock label="Component wrapper markup (HTML)" code={htmlSnippet} />
          </div>
          <div>
            <CodeBlock label="CSS style queries on custom properties (CSS)" code={styleCss} />
            <p class="note">
              <strong>Browser support (checked 2026-11-22):</strong> Container size queries (<code>container-type: inline-size</code>, <code>@container</code>, and <code>cqw</code>/<code>cqi</code> units) are Baseline Widely Available across Chrome 105+, Edge 105+, Safari 16+, and Firefox 110+ (<a href="https://webstatus.dev/features/container-queries" target="_blank" rel="noopener noreferrer">Web Platform Dashboard: container-queries</a>). Custom-property container style queries (<code>@container style(--prop: val)</code>) became Baseline Newly Available in May 2026 across Chrome 111+, Edge 111+, Safari 18+, and Firefox 151+ (<a href="https://webstatus.dev/features/container-style-queries" target="_blank" rel="noopener noreferrer">Web Platform Dashboard: container-style-queries</a>). Older browsers ignore the style query rules and keep the default card look. Tested in Chromium only.
            </p>
          </div>
        </div>
      </div>
    </section>

    <WhyFree
      nextHref="/lab/html-dialog/"
      nextTitle="HTML dialog modal with zero JavaScript"
      nextBlurb="Open, animate from display: none, and close a native modal using commandfor and @starting-style."
    />
  </div>
</Base>

<style>
  .cq-lab {
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 1.4rem;
  }
  .cq-head {
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: 1fr;
    align-items: end;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rim-strong);
  }
  @media (min-width: 56rem) {
    .cq-head {
      grid-template-columns: 1fr 1.15fr;
    }
  }
  .cq-head h2 {
    font-size: clamp(1.45rem, 2.7vw, 2rem);
    margin-bottom: 0.4rem;
  }
  .cq-head p {
    margin-bottom: 0;
  }
  .cq-controls {
    display: grid;
    gap: 0.85rem;
  }
  .cq-group {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .cq-group legend {
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.45rem;
  }
  .cq-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .cq-pills input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .cq-pills label {
    font: 600 0.84rem/1 var(--mono);
    padding: 0.55rem 0.85rem;
    min-height: 2.45rem;
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    background: var(--code-bg);
    color: var(--k-cream);
    border: 2px solid var(--rim-strong);
    cursor: pointer;
  }
  .cq-pills input:checked + label {
    background: var(--k-mint);
    color: var(--k-ink);
    border-color: var(--k-ink);
  }
  .cq-pills input:focus-visible + label {
    outline: 3px solid var(--k-gold);
    outline-offset: 2px;
  }

  .cq-stage {
    background: var(--code-bg);
    color: var(--k-cream);
    border: 1px solid var(--rim-strong);
    border-radius: var(--radius);
    padding: clamp(1rem, 2.5vw, 1.5rem);
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .cq-slot {
    container-type: inline-size;
    container-name: stash;
    --variant: default;
    width: 100%;
    min-width: min(230px, 100%);
    max-width: 100%;
    resize: horizontal;
    overflow: auto;
    padding: 0.4rem 0.4rem 0.7rem;
    border: 2px dashed rgb(194 255 230 / 0.34);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.03);
  }
  .cq-slot::-webkit-resizer {
    background: linear-gradient(135deg, transparent 48%, var(--k-coral) 48% 60%, transparent 60% 72%, var(--k-coral) 72% 84%, transparent 84%);
  }

  /* Pure-CSS preset widths and style-query custom property flips */
  .cq-lab:has(#cq-w-narrow:checked) .cq-slot { width: min(100%, 260px); }
  .cq-lab:has(#cq-w-mid:checked) .cq-slot { width: min(100%, 420px); }
  .cq-lab:has(#cq-w-wide:checked) .cq-slot { width: 100%; }

  .cq-lab:has(#cq-v-default:checked) .cq-slot { --variant: default; }
  .cq-lab:has(#cq-v-featured:checked) .cq-slot { --variant: featured; }
  .cq-lab:has(#cq-v-compact:checked) .cq-slot { --variant: compact; }

  .cq-card {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: 14px;
    background: var(--k-deep);
    color: var(--k-cream);
    border: 2px solid var(--k-mint);
  }
  .cq-emblem {
    display: none;
    background: var(--k-night);
    color: var(--k-mint);
    border: 1px solid rgb(134 227 190 / 0.35);
    border-radius: 12px;
    padding: 1rem;
    place-items: center;
    gap: 0.5rem;
  }
  .cq-emblem-tag {
    font-size: 0.76rem;
    color: var(--k-cream);
  }
  .cq-copy {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }
  .cq-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
  }
  .cq-pill {
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--k-mint);
    color: var(--k-ink);
  }
  .cq-state {
    font-size: 0.76rem;
    color: var(--k-gold);
  }
  .st-md, .st-lg { display: none; }
  .cq-title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.08rem, 4.4cqi, 1.7rem);
    line-height: 1.15;
    margin: 0;
    color: var(--k-cream);
  }
  .cq-blurb {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #e6dff2;
  }
  .cq-meta {
    margin: 0;
    font-size: 0.8rem;
    color: var(--k-mint);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }
  .cq-drag-hint {
    margin: 0;
    color: #d2cae2;
  }

  /* Container size query breakpoints */
  @container stash (min-width: 340px) {
    .cq-card {
      padding: 1.2rem;
    }
    .cq-emblem {
      display: grid;
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      padding: 0.8rem 1rem;
    }
    .st-sm { display: none; }
    .st-md { display: inline; }
  }

  @container stash (min-width: 540px) {
    .cq-card {
      grid-template-columns: 11.5rem 1fr;
      align-items: center;
      gap: 1.35rem;
      padding: 1.35rem 1.5rem;
    }
    .cq-emblem {
      grid-template-columns: 1fr;
      justify-items: center;
      padding: 1.25rem 1rem;
      align-self: stretch;
      align-content: center;
    }
    .st-md { display: none; }
    .st-lg { display: inline; }
  }

  /* Container style queries (Baseline Newly Available 2026) */
  @container stash style(--variant: featured) {
    .cq-card {
      border-color: var(--k-gold);
      background: #2b1840;
      box-shadow: 0 0 0 1px rgb(255 200 87 / 0.45);
    }
    .cq-emblem {
      color: var(--k-gold);
      border-color: rgb(255 200 87 / 0.45);
    }
    .cq-pill {
      background: var(--k-gold);
      color: var(--k-ink);
    }
    .cq-meta {
      color: var(--k-gold);
    }
  }

  @container stash style(--variant: compact) {
    .cq-card {
      border-style: dashed;
      border-color: var(--k-coral);
      padding: 0.85rem 1rem;
      gap: 0.65rem;
    }
    .cq-emblem {
      display: none;
    }
    .cq-blurb {
      display: none;
    }
    .cq-pill {
      background: var(--k-coral);
      color: var(--k-ink);
    }
  }

  .cq-guide {
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }
  .cq-ref-list {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: grid;
    gap: 0.8rem;
  }
  .cq-ref-list li {
    background: var(--code-bg);
    color: var(--k-cream);
    border: 1px solid var(--rim-strong);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
  }
  .cq-ref-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--k-mint);
    margin-bottom: 0.3rem;
  }
  .cq-ref-list p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.48;
    color: #e6dff2;
  }
</style>
