---
import Base from '../../layouts/Base.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PageHero from '../../components/PageHero.astro';
import WhyFree from '../../components/WhyFree.astro';

const cssProp = `<style>
  .box {
    width: 16rem; height: 8rem; padding: 0.8rem; border: 3px solid #86e3be; border-radius: 10px;
    resize: both;          /* none | both | horizontal | vertical */
    overflow: auto;        /* required: resize does nothing on overflow: visible */
    min-width: 10rem; min-height: 6rem;
    max-width: 100%;
  }

  /* Style the little corner (Chromium and Safari only) */
  .box::-webkit-resizer {
    background: linear-gradient(135deg, transparent 50%, #ff7b67 50% 60%, transparent 60% 72%, #ff7b67 72% 82%, transparent 82%);
  }
</style>

<div class="box"><p>Drag my corner.</p></div>`;

const customHtml = `<div class="panel" id="panel">
  <p>Resize me.</p>
  <button type="button" class="handle" id="handle"
    aria-label="Resize handle. Use the arrow keys to resize the panel."></button>
</div>
<p class="sr" role="status" id="live"></p>`;

const customCss = `/* hides text from the eye, keeps it for screen readers */
.sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.panel {
  box-sizing: border-box;   /* so the script's sizes include the border and padding */
  position: relative; width: 16rem; height: 8rem; min-width: 8rem; min-height: 5rem; max-width: 100%;
  background: #eef7f2; color: #170c26; border: 3px solid #86e3be; border-radius: 10px; padding: 0.8rem;
}
.handle {
  position: absolute; inset-block-end: 0; inset-inline-end: 0;
  width: 2rem; height: 2rem; border: 0; cursor: nwse-resize;
  background: linear-gradient(135deg, transparent 50%, #ff7b67 50%);
  touch-action: none;                              /* let the pointer drag, not scroll */
  -webkit-user-select: none; user-select: none;    /* no text selection while dragging */
}`;

const customJs = `const panel = document.getElementById('panel');
const handle = document.getElementById('handle');
const live = document.getElementById('live');
const STEP = 16, MIN_W = 128, MIN_H = 80;

function setSize(w, h) {
  const maxW = panel.parentElement.clientWidth;
  panel.style.width = Math.min(maxW, Math.max(MIN_W, w)) + 'px';
  panel.style.height = Math.max(MIN_H, h) + 'px';
}

let start = null;
handle.addEventListener('pointerdown', (e) => {
  if (e.button !== 0) return;
  start = { x: e.clientX, y: e.clientY, w: panel.offsetWidth, h: panel.offsetHeight };
  handle.setPointerCapture(e.pointerId);   // keep dragging when the pointer leaves the handle
});
handle.addEventListener('pointermove', (e) => {
  if (!start || !handle.hasPointerCapture(e.pointerId)) return;
  setSize(start.w + e.clientX - start.x, start.h + e.clientY - start.y);
});
handle.addEventListener('lostpointercapture', () => { start = null; });

handle.addEventListener('keydown', (e) => {
  const d = { ArrowRight: [STEP, 0], ArrowLeft: [-STEP, 0], ArrowDown: [0, STEP], ArrowUp: [0, -STEP] }[e.key];
  if (!d) return;
  e.preventDefault();
  setSize(panel.offsetWidth + d[0], panel.offsetHeight + d[1]);
  live.textContent = 'Panel is now ' + panel.offsetWidth + ' by ' + panel.offsetHeight + ' pixels.';
});`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'CSS resize handle: the property and a custom one',
  datePublished: '2026-11-22',
  url: 'https://patchbandit.com/lab/css-resize-handle/',
};
---
<Base
  title="CSS resize handle: native property and custom handle"
  description="How a CSS resize handle works: the resize property, corner styling, and a custom drag handle that works with the keyboard. Live demos and code to copy."
  schema={schema}
  ogType="article"
>
  <PageHero art="/art/raccoon-smirk.svg" alt="The raccoon, mask on, with a knowing smirk" tone="gold">
    <p class="crumbs"><a href="/">The story</a> / <a href="/lab/">The lab</a></p>
    <p class="eyebrow">Cheese puff · 2026-11-22</p>
    <h1>CSS resize handle: the property and a custom one</h1>
    <p class="lead">A CSS resize handle is the little corner you drag to make a box bigger or smaller. CSS draws one with a single property. If you want your own look, or want the keyboard to work too, you can build one by hand. Both ways are below, live, with the code.</p>
    <p class="story">Open up a box. Literally, this time: drag the corner.</p>
  </PageHero>

  <div class="route-host">
  <div class="route-rail" data-route aria-hidden="true"><i></i></div>
  <section class="band" data-node>
    <div class="wrap cols2 top">
      <div>
        <h2>Way 1: the resize property</h2>
        <p>Add <code>resize: both</code> and <code>overflow: auto</code> to a box, and the browser draws a corner handle for you. No script. Drag the corner of the box on the right.</p>
        <p>The handle's look is the browser's, though you can restyle it with <code>::-webkit-resizer</code> in Chromium and Safari. Touch support varies by device, and the plain property does not respond to the keyboard.</p>
        <CodeBlock label="The resize property (HTML and CSS)" code={cssProp} />
      </div>
      <div class="stagebox">
        <div class="native" role="group" aria-label="Demo: a box you can resize by dragging its corner">
          <p>Drag my corner. I use <code>resize: both</code>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band alt" data-node>
    <div class="wrap cols2 top">
      <div>
        <h2>Way 2: a custom handle</h2>
        <p>Want it to look your way, and work with the arrow keys? Build the handle as a real button, drag it with pointer events, and tell screen readers what happened. Try it: drag the corner, or tab to the handle and press the arrow keys.</p>
        <p>The big idea is <code>setPointerCapture</code>, which keeps the drag going even when your pointer slides off the handle. The arrow keys use the same size function as the drag, so both stay inside the same limits.</p>
        <div class="btn-row">
          <button type="button" class="btn alt" id="smaller">Smaller</button>
          <button type="button" class="btn alt" id="bigger">Bigger</button>
        </div>
        <p class="muted">The buttons are there for anyone who cannot drag at all. No pointer needed.</p>
      </div>
      <div class="stagebox">
        <div class="panel" id="panel">
          <p>Resize me. I use a custom handle.</p>
          <button type="button" class="handle" id="handle" aria-label="Resize handle. Use the arrow keys to resize the panel."></button>
        </div>
        <p class="sr" role="status" id="live"></p>
      </div>
    </div>
  </section>

  <section class="band" data-node>
    <div class="wrap">
      <h2>The code for the custom handle</h2>
      <div class="cols2 top">
        <div>
          <CodeBlock label="Handle markup (HTML)" code={customHtml} />
          <CodeBlock label="Handle styles (CSS)" code={customCss} />
        </div>
        <CodeBlock label="Handle behavior (JavaScript)" code={customJs} />
      </div>
      <p class="note">Tested in Chromium only. Pointer events and <code>setPointerCapture</code> are long supported in current browsers. On a touch screen the handle has <code>touch-action: none</code>, so dragging it does not scroll the page.</p>
    </div>
  </section>

  <WhyFree nextHref="/lab/html-vertical-divider/" nextTitle="HTML vertical divider: six ways to draw one" nextBlurb="A line between two things side by side. HTML has no tag for it, so here are six ways with CSS." />
  </div>
</Base>

<style>
  .stagebox { --mint: var(--k-mint); --coral: var(--k-coral); background: var(--code-bg); color: var(--k-cream); border-radius: 12px; padding: 1rem; min-height: 14rem; align-self: stretch; overflow: hidden; min-width: 0; }
  .native { resize: both; overflow: auto; width: 16rem; height: 8rem; min-width: 8rem; min-height: 5rem; max-width: 100%; background: #241539; border: 3px solid var(--mint); border-radius: 10px; padding: 0.8rem; }
  .native p { margin: 0; }
  .native::-webkit-resizer { background: linear-gradient(135deg, transparent 50%, var(--coral) 50% 60%, transparent 60% 72%, var(--coral) 72% 82%, transparent 82%); }
  .panel { position: relative; width: 16rem; height: 8rem; min-width: 8rem; min-height: 5rem; max-width: 100%; background: #241539; border: 3px solid var(--mint); border-radius: 10px; padding: 0.8rem; }
  .panel p { margin: 0; }
  .handle { position: absolute; inset-block-end: 0; inset-inline-end: 0; width: 2.4rem; height: 2.4rem; border: 0; cursor: nwse-resize; background: linear-gradient(135deg, transparent 50%, var(--coral) 50%); touch-action: none; -webkit-user-select: none; user-select: none; border-end-end-radius: 6px; padding: 0; }
</style>

<script>
  const panel = document.getElementById('panel');
  const handle = document.getElementById('handle');
  const live = document.getElementById('live');
  const smaller = document.getElementById('smaller');
  const bigger = document.getElementById('bigger');
  const STEP = 16, MIN_W = 128, MIN_H = 80;

  if (panel && handle && live) {
    const setSize = (w: number, h: number) => {
      const maxW = panel.parentElement ? panel.parentElement.clientWidth - 32 : w;
      panel.style.width = Math.min(maxW, Math.max(MIN_W, w)) + 'px';
      panel.style.height = Math.max(MIN_H, h) + 'px';
    };
    const announce = () => { live.textContent = `Panel is now ${panel.offsetWidth} by ${panel.offsetHeight} pixels.`; };

    let start: { x: number; y: number; w: number; h: number } | null = null;
    handle.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      start = { x: e.clientX, y: e.clientY, w: panel.offsetWidth, h: panel.offsetHeight };
      handle.setPointerCapture(e.pointerId);
    });
    handle.addEventListener('pointermove', (e) => {
      if (!start || !handle.hasPointerCapture(e.pointerId)) return;
      setSize(start.w + e.clientX - start.x, start.h + e.clientY - start.y);
    });
    handle.addEventListener('lostpointercapture', () => { start = null; });

    handle.addEventListener('keydown', (e) => {
      const moves: Record<string, [number, number]> = {
        ArrowRight: [STEP, 0], ArrowLeft: [-STEP, 0], ArrowDown: [0, STEP], ArrowUp: [0, -STEP],
      };
      const d = moves[e.key];
      if (!d) return;
      e.preventDefault();
      setSize(panel.offsetWidth + d[0], panel.offsetHeight + d[1]);
      announce();
    });
    smaller?.addEventListener('click', () => { setSize(panel.offsetWidth - STEP * 2, panel.offsetHeight - STEP); announce(); });
    bigger?.addEventListener('click', () => { setSize(panel.offsetWidth + STEP * 2, panel.offsetHeight + STEP); announce(); });
  }
</script>
