---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SNACK_JAR } from '../data/site';

const facts = [
  {
    tag: 'The tools',
    title: 'Nothing changes for you',
    body: 'Every tool and lab snippet stays free and open, tips or no tips. You get no perks, no paywall, and no nagging.',
  },
  {
    tag: 'The card',
    title: 'Stripe handles the payment',
    body: "Stripe takes your payment on its own page, and we never see your card number. We receive the amount, the email address Stripe's page asks for, and any name you choose to enter.",
  },
  {
    tag: 'The tax bit',
    title: 'No tax deduction',
    body: 'Patch Bandit is not a charity, so a tip is not tax-deductible as a gift. Your card statement shows PATCHBANDIT.',
  },
  {
    tag: 'The snacks',
    title: 'Where it goes',
    body: 'Domain bills, the odd paid tool for testing, and the snacks that fuel the next build. Tips also show us which tools are actually earning their keep.',
  },
];
---
<Base
  title="The snack jar: tip the raccoon | Patch Bandit"
  description="Patch Bandit tools stay free. If one saved you a monthly fee, toss a snack in the jar. Stripe takes the payment; we never see your card."
>
  <PageHero art="/art/raccoon-celebrate.svg" alt="The raccoon celebrating with both paws up" tone="gold">
    <p class="eyebrow mono">&gt; snack jar: {SNACK_JAR.url ? 'open' : 'opening soon'}</p>
    <h1>The snack jar</h1>
    <p class="lead">Every tool here stays free, no strings attached. If one saved you a monthly bill and you want to toss a snack in the jar, pick any amount from two dollars up.</p>
    <div class="btn-row">
      {SNACK_JAR.url ? (
        <a class="btn" href={SNACK_JAR.url} target="_blank" rel="noopener noreferrer">Toss in a snack</a>
      ) : (
        <p class="mono small muted">The jar opens in a day or two. Still wiping off the counter.</p>
      )}
      <a class="btn alt" href="/tools/">See the tools</a>
    </div>
  </PageHero>

  <section class="band tight" aria-labelledby="how-h">
    <div class="wrap">
      <div class="split-head">
        <div>
          <p class="eyebrow">Straight facts first</p>
          <h2 id="how-h">What happens when you toss in a snack</h2>
        </div>
        <p class="muted">The button opens a Stripe checkout page in a new tab. Stripe's privacy policy explains how Stripe uses your information, and our <a href="/privacy/">privacy page</a> covers the rest of this site.</p>
      </div>
      <ul class="grid g2 sub sub3">
        {facts.map((f) => (
          <li class="card glint">
            <p class="tag">{f.tag}</p>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
